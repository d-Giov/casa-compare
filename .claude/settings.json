{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node C:/Users/Davide/.claude/scripts/hooks/preflight-check.js"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(npm run*)",
      "Bash(npm install*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(node *)"
    ]
  }
}
